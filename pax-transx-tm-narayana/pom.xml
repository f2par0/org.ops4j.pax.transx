<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.ops4j.pax.transx</groupId>
        <artifactId>pax-transx</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>pax-transx-tm-narayana</artifactId>
    <packaging>bundle</packaging>

    <dependencies>

        <!-- pax-transx own artifacts -->

        <dependency>
            <groupId>org.ops4j.pax.transx</groupId>
            <artifactId>pax-transx-tm-core</artifactId>
        </dependency>

        <!-- OSGi -->

        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.cmpn</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.felix</groupId>
            <artifactId>org.apache.felix.utils</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JBoss components -->

        <dependency>
            <groupId>org.jboss.narayana.jta</groupId>
            <artifactId>narayana-jta</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.narayana.jts</groupId>
            <artifactId>narayana-jts-integration</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.narayana.arjunacore</groupId>
            <artifactId>arjuna</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Spring -->

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test dependencies -->

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Logging dependencies -->

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j-impl</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <instructions>
                        <Import-Package>
                            !com.arjuna.*,
                            !javax.resource.spi.*,
                            !javax.transaction,
                            !org.jboss.tm.*,
                            !org.jboss.narayana.osgi.jta,
                            jakarta.transaction;version="[2.0,3)",
                            javax.transaction.xa;version=!,
                            jakarta.resource.spi;version="[2,3)",
                            javax.xml.parsers,
                            org.xml.sax,
                            org.xml.sax.helpers,
                            org.springframework.*;version="[6,7)";resolution:=optional,
                            org.apache.karaf.shell.*;resolution:=optional,
                            <!-- imports collected from the closure of embedded dependencies -->
                            javax.crypto,
                            javax.crypto.spec,
                            javax.net.ssl,
                            javax.security.auth.x500,
                            javax.security.cert,
                            org.bouncycastle.asn1.x500;resolution:=optional,
                            org.bouncycastle.cert;resolution:=optional,
                            org.bouncycastle.cert.jcajce;resolution:=optional,
                            org.bouncycastle.jce.provider;resolution:=optional,
                            org.bouncycastle.operator;resolution:=optional,
                            org.bouncycastle.operator.jcajce;resolution:=optional,
                            com.google.protobuf;resolution:=optional,
                            com.google.protobuf.nano;resolution:=optional,
                            com.jcraft.jzlib;resolution:=optional,
                            com.ning.compress;resolution:=optional,
                            com.ning.compress.lzf;resolution:=optional,
                            com.ning.compress.lzf.util;resolution:=optional,
                            org.slf4j;resolution:=optional,
                            org.slf4j.helpers;resolution:=optional,
                            org.slf4j.spi;resolution:=optional,
                            sun.misc;resolution:=optional,
                            sun.nio.ch;resolution:=optional,
                            android.os;resolution:=optional,
                            org.apache.activemq.artemis.core.*;resolution:=optional,
                            *
                        </Import-Package>
                        <Export-Package>
                            org.jboss.tm.*;-split-package:=merge-first,
                            org.jboss.narayana.osgi.jta
                        </Export-Package>
                        <Private-Package>
                            org.ops4j.pax.transx.tm.impl;-split-package:=merge-first,
                            org.jboss.narayana.osgi.jta.internal;-split-package:=merge-first
                            com.arjuna.ats;-split-package:=merge-first,
                            com.arjuna.ats.common,
                            com.arjuna.ats.jta.common,
                            com.arjuna.ats.jbossatx,
                            com.arjuna.ats.internal.jbossatx,
                            com.arjuna.ats.internal.jta.*,
                            com.arjuna.common.util.propertyservice,
                            com.arjuna.common.internal.util.propertyservice,
                            com.arjuna.common.util.*,
                            com.arjuna.common.logging.*,
                            com.arjuna.common.internal*,
                            com.arjuna.ats.jbossatx.jta,
                            com.arjuna.ats.jbossatx.logging,
                            com.arjuna.ats.arjuna.recovery,
                            com.arjuna.ats.internal.arjuna.recovery,
                            com.arjuna.ats.arjuna.exceptions,
                            com.arjuna.ats.arjuna.common,
                            com.arjuna.ats.arjuna.logging,
                            com.arjuna.ats.jta.exceptions,
                            com.arjuna.ats.arjuna.coordinator,
                            com.arjuna.ats.internal.arjuna.objectstore,
                            com.arjuna.ats.arjuna.objectstore,
                            com.arjuna.ats.internal.arjuna.coordinator,
                            com.arjuna.ats.arjuna.tools.osb.mbean,
                            com.arjuna.ats.arjuna.utils,
                            com.arjuna.ats.arjuna,
                            com.arjuna.ats.arjuna.tools.osb.util,
                            com.arjuna.ats.arjuna.coordinator.abstractrecord,
                            com.arjuna.ats.internal.jta.recovery.arjunacore,
                            com.arjuna.ats.jta,
                            com.arjuna.ats.jta.logging,
                            com.arjuna.ats.arjuna.state,
                            com.arjuna.ats.jta.recovery,
                            com.arjuna.ats.internal.arjuna.abstractrecords,
                            com.arjuna.ats.jta.resources,
                            com.arjuna.ats.internal.arjuna.objectstore.hornetq,
                            com.arjuna.ats.internal.arjuna.common,
                            com.arjuna.ats.internal.arjuna.utils,
                            com.arjuna.ats.internal.jbossatx.jta
                        </Private-Package>
                        <Bundle-Activator>
                            org.jboss.narayana.osgi.jta.internal.Activator
                        </Bundle-Activator>
                        <Provide-Capability>
                            osgi.service;objectClass="jakarta.transaction.TransactionManager",
                            osgi.service;objectClass="jakarta.transaction.TransactionSynchronizationRegistry",
                            osgi.service;objectClass="jakarta.transaction.UserTransaction",
                            osgi.service;objectClass="org.ops4j.pax.transx.tm.TransactionManager",
                            osgi.service;objectClass="org.springframework.transaction.PlatformTransactionManager"
                            osgi.service;objectClass="org.jboss.narayana.osgi.jta.ObjStoreBrowserService"
                        </Provide-Capability>
                        <Include-Resource>
                            {maven-resources}
                        </Include-Resource>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
